{{#extend "home"}}

  {{#content "carousel"}}
  {{> "home/carousel"}}
  {{/content}}

  {{#content "main"}}
  <!-- START THE FEATURETTES -->
  <div class="row featurette">
    {{> "home/collective"}}
  </div>

  <div class="row featurette-divider">
    <iframe width="100%" height="166" scrolling="no" frameborder="no" src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/317030874&amp;color=ff5500&amp;auto_play=true&amp;hide_related=false&amp;show_comments=true&amp;show_user=true&amp;show_reposts=false"></iframe>
  </div>

  {{!-- Turned off under SCMS and still off. To bring it back, uncomment:
  <hr class="featurette-divider">
  <div class="row featurette">
    {{> "home/sponsors"}}
  </div>
  --}}

  <hr class="featurette-divider">
  <div class="row featurette">
    {{> "home/charity"}}
  </div>

  <hr class="featurette-divider">
  <div class="row featurette">
    {{> "home/facebook"}}
  </div>

  {{> "home/calls-to-action"}}
  {{/content}}

{{/extend}}
