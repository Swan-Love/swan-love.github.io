{{!-- Converted from _pages/index/social.erb. The three image paths were the
      one place on the site that used document-relative URLs (images/home/...);
      {{asset}} makes them root-relative like everything else. --}}
<hr class="featurette-divider">

<!-- Three columns of text below the carousel -->
<div class="row">

  <div class="col-lg-4">
    <a href="{{url config.site.ticketsUrl}}" target="_blank">
      <img class="img-circle" src="/{{asset "images/home/we-got-tickets.jpg"}}" alt="We Got Tickets">
    </a>
    <h2>Get Tickets</h2>
    <p>Avoid disappointment and book tickets to our next event.</p>
    <p><a class="btn btn-default" href="{{url config.site.ticketsUrl}}" target="_blank" role="button">Book Tickets &raquo;</a></p>
  </div><!-- /.col-lg-4 -->

  <div class="col-lg-4">
    <a href="{{url config.site.newsletterUrl}}" target="_blank" class="amodal" data-title="Swanlove Newsletter">
      <img class="img-circle" src="/{{asset "images/home/newsletter-badge.png"}}" alt="Swanlove Newsletter"></a>
    <h2>Newsletter</h2>
    <p>Sign-up to our newsletter to get up-to-date information on our events.</p>
    <p><a class="btn btn-default amodal" href="{{url config.site.newsletterUrl}}" role="button" target="_blank" data-title="Swanlove Newsletter">Signup &raquo;</a></p>
  </div><!-- /.col-lg-4 -->

  <div class="col-lg-4">
    <a href="https://www.facebook.com/SwanLoveEvents" target="_blank">
      <img class="img-circle" src="/{{asset "images/home/facebook-badge.jpg"}}" alt="Facebook">
    </a>
    <h2>Facebook</h2>
    <p>Follow us on Facebook for our most recent photos, stories, interesting links, etc.</p>
    <p><a class="btn btn-default" href="https://www.facebook.com/SwanLoveEvents" target="_blank" role="button">Open Page &raquo;</a></p>
  </div><!-- /.col-lg-4 -->

</div><!-- /.row -->
